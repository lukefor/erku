<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelContentNode" extends="Node">
	<interface>
		<field id="total" type="integer" value="0" />
		<field id="channel_id" type="integer" value="-1" />
		<field id="group_id" type="integer" value="-1" />
		<field id="Number" type="integer" value="-1" />
		<field id="Episode" type="integer" value="-1" />
		<field id="Season" type="integer" value="-1" />
		<field id="Title" type="string" value="" />
		<field id="SeriesTitle" type="string" value="" />
		<field id="SeasonTitle" type="string" value="" />
		<field id="HDPosterUrl" type="string" value="" />
		<field id="Url" type="string" value="" />
		<field id="StreamFormat" type="string" value="" />
		<field id="Year" type="string" value="" />
		<field id="SeriesYear" type="string" value="" />
		<field id="SeasonYear" type="string" value="" />
		<field id="HttpHeaders" type="array" value="" />
		<field id="Favorite" type="bool" value="false" />
		<field id="SubtitleConfig" type="assocarray" value="" />
		<!-- Catch-up: the URL template of archived programs. Empty if the channel doesn't support catch-up. -->
		<field id="CatchupSource" type="string" value="" />
		<field id="CatchupStreamFormat" type="string" value="" />
		<field id="CatchupDays" type="integer" value="0" />
		<field id="CatchupCorrection" type="integer" value="0" />	<!-- In seconds. -->
		<field id="TimeZoneOffset" type="integer" value="0" />	<!-- The offset (in seconds) that's been applied to the EPG program times. -->
		<field id="IsCatchup" type="bool" value="false" />	<!-- The content plays an archived program (its only child). -->
		<field id="CatchupStreamStart" type="integer" value="0" />	<!-- The program time (in the EPG's time format) at the beginning of the catch-up stream. -->
	</interface>
</component>
